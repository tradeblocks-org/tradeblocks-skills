{
  "version": "0.1.0",
  "description": "Default thresholds for the V1 triage checks C1-C8. Draft values from the product requirements, checked on the synthetic calibration cases A1-A7 (tests/fixtures/triage). A user copy set in the local config overrides this file. Change values only here, with date and reason.",
  "bootstrap": {
    "seed": 42,
    "resamples": 2000,
    "ciLevel": 0.95,
    "description": "Passed to paired_bootstrap_comparison for C4. Fixed so the same inputs give the same verdict."
  },
  "requires": {
    "tradeblocks": ">=4.6.2",
    "tools": {
      "get_rule_calendar": [],
      "paired_bootstrap_comparison": [
        "unobservedDays",
        "grid"
      ],
      "get_statistics": [
        "topDays",
        "capitalBasis"
      ],
      "get_period_returns": [],
      "stress_test": []
    },
    "description": "TradeBlocks tools and options the checks call: get_rule_calendar (C3, TradeBlocks PR #641), paired_bootstrap_comparison unobservedDays/grid (C4, #640; interval fix #639), get_statistics topDays/capitalBasis (C5, #642). A check whose tool or option is missing is reported as not run."
  },
  "checks": {
    "C1": {
      "name": "Backtest matches its source",
      "need": "N43",
      "runsWhen": "a source description is supplied",
      "rules": [
        {
          "metric": "confidence",
          "op": "<",
          "value": 0.8,
          "outcome": "cap",
          "unit": "share"
        },
        {
          "metric": "assumedCoreFields",
          "op": ">",
          "value": 0,
          "outcome": "cap",
          "unit": "fields"
        }
      ],
      "weights": {
        "core": 2,
        "secondary": 1,
        "coreFields": [
          "underlying",
          "structure",
          "legs",
          "dte",
          "entry_time",
          "stop",
          "exit"
        ],
        "secondaryFields": [
          "entry_filters",
          "days_traded",
          "reentry",
          "sizing",
          "fills",
          "date_range"
        ]
      },
      "changed": "2026-11-19",
      "reason": "calibrated on A1–A7, 2026-11-19",
      "origin": "Draft from the requirements: one assumed stop rule can flip a 0DTE result."
    },
    "C2": {
      "name": "Sample can carry a verdict",
      "need": "N4",
      "rules": [
        {
          "metric": "trades",
          "op": "<",
          "value": 100,
          "outcome": "cap",
          "unit": "trades"
        },
        {
          "metric": "months",
          "op": "<",
          "value": 24,
          "outcome": "cap",
          "unit": "months"
        }
      ],
      "changed": "2026-11-19",
      "reason": "calibrated on A1–A7, 2026-11-19",
      "origin": "Draft from the requirements."
    },
    "C3": {
      "name": "Backtest trades the stated expiries",
      "need": "N45, N18",
      "rules": [
        {
          "metric": "maxYearDteMismatchShare",
          "op": ">",
          "value": 0.05,
          "outcome": "cap",
          "unit": "share"
        },
        {
          "metric": "missingRuleDayShare",
          "op": ">",
          "value": 0.05,
          "outcome": "cap",
          "unit": "share"
        }
      ],
      "changed": "2026-11-19",
      "reason": "calibrated on A1–A7, 2026-11-19",
      "origin": "Draft from the requirements; fix rules (e.g. exact DTE, later start date) and rerun."
    },
    "C4": {
      "name": "Edge is more than harvested premium (gate)",
      "need": "N19",
      "gate": true,
      "rules": [
        {
          "metric": "point",
          "op": "<=",
          "value": 0,
          "outcome": "reject",
          "unit": "USD/day"
        },
        {
          "metric": "ciLow",
          "op": "<=",
          "value": 0,
          "outcome": "cap",
          "unit": "USD/day"
        }
      ],
      "changed": "2026-11-19",
      "reason": "calibrated on A1–A7, 2026-11-19",
      "origin": "Draft from the requirements (community baseline rule): reject when the strategy does not beat its naive version; cap while the 95 % interval includes 0."
    },
    "C5": {
      "name": "Result does not hang on a few days",
      "need": "N23",
      "rules": [
        {
          "metric": "plWithoutBest5",
          "op": "<=",
          "value": 0,
          "outcome": "reject",
          "unit": "USD"
        },
        {
          "metric": "best10Share",
          "op": ">",
          "value": 0.5,
          "outcome": "cap",
          "unit": "share"
        },
        {
          "metric": "positiveYearShare",
          "op": "<",
          "value": 0.6,
          "outcome": "cap",
          "unit": "share"
        }
      ],
      "changed": "2026-11-19",
      "reason": "calibrated on A1–A7, 2026-11-19",
      "origin": "Draft from the requirements."
    },
    "C6": {
      "name": "Strategy survives stress",
      "need": "N25",
      "rules": [
        {
          "metric": "stressPeriodsInRecord",
          "op": "<",
          "value": 1,
          "outcome": "cap",
          "unit": "periods"
        },
        {
          "metric": "worstStressLossInAvgMonths",
          "op": ">",
          "value": 12,
          "outcome": "reject",
          "unit": "months"
        }
      ],
      "changed": "2026-11-19",
      "reason": "calibrated on A1–A7, 2026-11-19",
      "origin": "Draft from the requirements: worst built-in stress period loses more than 12 months of average P&L."
    },
    "C7": {
      "name": "Edge survives realistic costs",
      "need": "N44",
      "rules": [
        {
          "metric": "cost2xPl",
          "op": "<=",
          "value": 0,
          "outcome": "reject",
          "unit": "USD"
        },
        {
          "metric": "cost2xKeepShare",
          "op": "<",
          "value": 0.5,
          "outcome": "cap",
          "unit": "share"
        }
      ],
      "changed": "2026-11-19",
      "reason": "calibrated on A1–A7, 2026-11-19",
      "origin": "Draft from the requirements; both slippage values come from the user's cost file."
    },
    "C8": {
      "name": "Edge does not live on bad-quote stops",
      "need": "N44",
      "runsWhen": "the author run uses intra-minute stops",
      "rules": [
        {
          "metric": "minuteStopPl",
          "op": "<=",
          "value": 0,
          "outcome": "reject",
          "unit": "USD"
        },
        {
          "metric": "minuteStopDropShare",
          "op": ">",
          "value": 0.5,
          "outcome": "cap",
          "unit": "share"
        }
      ],
      "changed": "2026-11-19",
      "reason": "calibrated on A1–A7, 2026-11-19",
      "origin": "Draft from the requirements."
    }
  }
}
